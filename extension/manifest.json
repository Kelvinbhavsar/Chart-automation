{
  "manifest_version": 3,
  "name": "Nifty Options Screenshot Capture",
  "version": "1.0.0",
  "description": "Capture screenshots of ITM CE and PE options based on current Nifty price from Zerodha Kite",
  "permissions": [
    "activeTab",
    "storage",
    "downloads",
    "scripting",
    "webRequest"
  ],
  "host_permissions": [
    "https://kite.zerodha.com/*",
    "https://api.kite.trade/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://kite.zerodha.com/*"],
      "js": ["api.js", "chart-renderer.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["api.js", "chart-renderer.js"],
      "matches": ["https://kite.zerodha.com/*"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

